# ===== Admin bot (aiogram) =====
# Bot token from @BotFather. Required for `run`; without it `once`/`mock` print notifications to stdout.
BOT_TOKEN=
# Telegram user ids of the admins, comma-separated (only they can use the bot and its buttons)
ADMIN_IDS=

# ===== Telegram account (Telethon): Mini App initData for @mrkt, Telegram's gift valuation, /hunt link lookup =====
# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Session file: data/<TG_SESSION_NAME>.session (created by `python -m mrkt_autobuy login`, chmod 600)
TG_SESSION_NAME=mrkt
# MRKT bot and Mini App short name; the URL is the fallback for RequestWebView
MRKT_BOT_USERNAME=mrkt
MRKT_APP_SHORT_NAME=app
MRKT_WEBAPP_URL=https://cdn.tgmrkt.io/
# Seconds before initData is requested again (and right away on 401/403)
INIT_DATA_TTL=3000

# ===== MRKT API =====
MRKT_API_BASE=https://api.tgmrkt.io/api/v1
# Optional: a ready MRKT token (from /auth). If set, Telethon is only needed to refresh it.
MRKT_TOKEN=
# HTTP client: curl_cffi (Chrome-like TLS, the host is behind Cloudflare) or httpx
HTTP_BACKEND=curl_cffi
# Proxy for the API, e.g. http://user:pass@host:port or socks5://host:port
HTTP_PROXY=
HTTP_TIMEOUT=10

# ===== Safety and limits =====
# true = practice only (purchases are simulated). A hard lock: no bot command or stored setting can lift it.
# LIVE needs DRY_RUN=false here AND /dry off in the bot (its go-live button, or /dry off confirm), and lasts
# LIVE_ARM_HOURS only. Setting DRY_RUN=true cancels a live window for good: going live again needs a new /dry off.
DRY_RUN=true
# Max all-in cost (fees included) of one gift, TON (hard ceiling above every rule)
MAX_PRICE_TON=10
# Budget for a rolling 24 hours, TON (all-in cost)
DAILY_BUDGET_TON=50
# Max buys in the last hour
MAX_BUYS_PER_HOUR=3
# LIVE switches back to practice by itself after this many hours (/dry off renews it)
LIVE_ARM_HOURS=24
# Buys costing more than this always ask first, even in auto mode. 0 = half of MAX_PRICE_TON
CONFIRM_ABOVE_TON=0
# Breakers: pause a rule when its floor falls more than CRASH_PCT within 1 h (for CRASH_PAUSE_MIN minutes)
CRASH_PCT=20
CRASH_PAUSE_MIN=60
# Back to practice after LOSS_STREAK_N live buys in a row marked more than LOSS_STREAK_PCT below cost
LOSS_STREAK_N=3
LOSS_STREAK_PCT=10
# Pause when the balance falls by more than the bot's own live spend plus this tolerance
BALANCE_GUARD=true
BALANCE_TOLERANCE_TON=0.5
# Pause after this many failed live buys in a row
AUTO_PAUSE_ERRORS=5
# Warn once when no cycle has succeeded for this many seconds
STALE_DATA_SEC=300
# /doctor warns when the market balance is above HOT_WALLET_WARN_X x DAILY_BUDGET_TON
HOT_WALLET_WARN_X=3

# ===== Fees (every price shown is net of them) =====
# TODO(verify): MRKT fee schedule. Defaults are assumptions; the sell fee is also derived per collection
# from salePrice vs salePriceWithoutFee when listings carry both.
BUY_FEE_PCT=0
SELL_FEE_PCT=5
WITHDRAW_FEE_TON=0
# Set to true once you have checked the fees; until then /status and cards say "(unverified)"
FEES_VERIFIED=false

# ===== Honest floor and trap filter =====
# Cluster floor: lowest ask with at least CLUSTER_K other asks within CLUSTER_BAND_PCT above it
CLUSTER_K=2
CLUSTER_BAND_PCT=10
# Comparables needed for "high" confidence: collection-only rules / rules pinning model, backdrop or symbol
MIN_COMPARABLES_COLLECTION=5
MIN_COMPARABLES_ATTR=3
# Confidence drops one level when the floor moved more than this within 1 h
FLOOR_JUMP_PCT=25
# A price below this % of the floor is "too good to be true": alert only, never auto-bought
TOO_GOOD_PCT=25
# Retention of the observation tape, floor snapshots and the /why decision log, days
OBS_TTL_DAYS=14
SNAPSHOT_TTL_DAYS=14
DECISIONS_TTL_DAYS=7

# ===== Deal cards =====
# Seconds a confirm card waits for your tap
CONFIRM_TTL_SEC=90
# Silent "missed by a hair" card when exactly one numeric check fails by at most this % (max per hour)
NEAR_MISS_PCT=5
NEAR_MISS_MAX_PER_HOUR=3
# Hours of history the /hunt preview replays
PREVIEW_HOURS=24
# Show costs in your currency too: usd | none
DISPLAY_CURRENCY=usd

# ===== Second opinion: Telegram's valuation and your other markets =====
# Time budget for these lookups, shared by all candidates in one cycle, seconds
PEERS_TIMEOUT_SEC=3
# payments.getUniqueStarGiftValueInfo via the Telethon session (cached, rate-limited)
TG_VALUE_ENABLED=true
TG_VALUE_TTL=600
TG_VALUE_MAX_PER_MIN=10
# Ask first when the floor is thin and the cost is above Telegram's average / last sale
TG_VALUE_GUARD=true
# TON -> USD rate (keyless)
TON_RATE_URL=https://tonapi.io/v2/rates?tokens=ton&currencies=usd
TON_RATE_TTL=600
# Floor snapshot files written by your other bots, comma-separated, e.g. ../portals-autobuy/data/floors_portals.json
# This bot writes data/floors_mrkt.json for them (schema in the README; no secrets inside).
PEER_FLOOR_FILES=
# Ignore snapshot files older than this, seconds
PEER_MAX_AGE_SEC=600
# Read Portals' public collection floors when no fresh Portals snapshot exists (every PORTALS_PUBLIC_TTL s)
PEER_PORTALS_PUBLIC=false
PORTALS_PUBLIC_URL=https://portal-market.com/api/collections?limit=500
PORTALS_PUBLIC_TTL=300
# Ask first when the same gift is this % cheaper all-in on another market
CHEAPER_ELSEWHERE_PCT=3

# ===== Practice ledger, live gate and digest =====
# Practice positions are marked for this many days
PAPER_HORIZON_DAYS=7
# Marks reuse floor snapshots younger than this; otherwise at most MARK_MAX_QUERIES searches per pass
MARK_MAX_AGE_SEC=1800
MARK_MAX_QUERIES=10
MARK_INTERVAL_SEC=3600
# A rule is "ready" for live after GATE_MIN_TRADES practice buys within GATE_DAYS that are not losing
GATE_MIN_TRADES=5
GATE_DAYS=7
# Daily digest hour in local time (-1 = off) and your UTC offset
DIGEST_HOUR=-1
TZ_OFFSET_HOURS=3

# ===== Shadow rules, event log, optional LLM =====
# New rules from /addrule and /hunt start in shadow (practice only) until promoted
SHADOW_NEW_RULES=true
SHADOW_MIN_HOURS=24
SHADOW_MIN_MATCHES=5
SHADOW_MAX_HOURS=168
# A practice buy whose listing vanished within this many seconds counts as a race you probably lost
SNIPED_WINDOW_SEC=120
# JSON-lines event log (one decision per line) and its rotation size
EVENTS_FILE=data/events.jsonl
EVENTS_MAX_MB=20
# events.jsonl files of your other bots, for the "Other bots" digest section, comma-separated
PEER_EVENT_FILES=
# Optional [Explain more] button (needs `pip install anthropic`); without a key no call is ever made
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ===== Polling =====
# Pause between cycles, seconds (exponential backoff up to MAX_BACKOFF on 429/errors)
POLL_INTERVAL=2
MAX_BACKOFF=60
# Listings per request (cheapest + newest)
PAGE_SIZE=20
# Also request the newest listings (one more request per rule group per cycle)
SCAN_NEWEST=true
# How often collection floors are refreshed from /gifts/collections (also the floor snapshot cadence), seconds
FLOOR_CACHE_TTL=60

# ===== Storage and misc =====
DB_PATH=data/mrkt_autobuy.sqlite3
DATA_DIR=data
# Optional rules file, loaded at start (see rules.example.json)
RULES_FILE=rules.json
LOG_LEVEL=INFO
